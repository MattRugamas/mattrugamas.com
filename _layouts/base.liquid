<!doctype html>
<html lang="en">

  <head>
    {% if site.google_analytics and jekyll.environment == 'production' %}
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{ site.google_analytics }}');
      </script>
    {% endif %}
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/assets/css/styles.css" />
    {% include faviconpackage.html %}
    {% comment %}
      Runs after the theme-color metas exist so a stored theme can update them,
      and before first paint so there is no flash of the wrong palette.
    {% endcomment %}
    <script>
      (function () {
        var t = localStorage.getItem('theme');
        if (t) {
          document.documentElement.setAttribute('data-theme', t);
          var c = t === 'dark' ? '#141414' : '#FAFAFA';
          var m = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < m.length; i++) m[i].setAttribute('content', c);
        }
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var back = nav && nav.type === 'back_forward';
        var sameOrigin = false;
        if (document.referrer) {
          try { sameOrigin = new URL(document.referrer).origin === location.origin; } catch (e) {}
        }
        if (!reduce && !back && !sameOrigin) {
          document.documentElement.setAttribute('data-arrive', '');
        }
      })();
    </script>
    {% feed_meta %}
    {% seo %}
  </head>

  <body>
    {% if page.minimal_chrome %}
    {% include minimal-chrome.html %}
    {% else %}
    {% include navigation.html %}
    {% endif %}
    {{ content }}
    {% unless page.minimal_chrome %}
    <footer>
      <p>2019-{{ 'now' | date: '%Y' }} — Made with ❤️ on
        <strong>
          <a href="https://www.jekyllrb.com">Jekyll</a>
        </strong>
        and
        <strong>
          <a href="https://pages.github.com">GitHub Pages</a>
        </strong>.</p>
    </footer>
    {% endunless %}
    <script src="/assets/js/site.js" defer></script>
    <script src="/assets/js/analytics.js" defer></script>
  </body>

</html>
